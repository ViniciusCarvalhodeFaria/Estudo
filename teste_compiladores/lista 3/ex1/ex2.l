%option noyywrap

%{
#include <stdio.h>
#include <stdlib.h>
#include <string.h>


#define YY_DECL int yylex()

#include "ex2.tab.h" // Include the header file generated by Bison
%}

DIGITO [0-9]
NUM {DIGITO}+
VALOR_REAL {DIGITO}+\.{DIGITO}+
SOMA_SINAL [+]
SUB_SINAL [-]
MUL_SINAL [*]
DIV_SINAL [/]
LPAR [(]
RPAR [)]
DTYPES int|float|double|char|void
NEW_LINE \n

%%
[ \t]+    /* Ignore whitespace */;
{VALOR_REAL} 	{
	yylval.fval = atof(yytext);
	return T_FLOAT;
}
{NUM}         	{
	yylval.ival = atoi(yytext);
	return T_INT;
}
{NEW_LINE} 	{
	return T_NEWLINE;
}
{LPAR} 	{
	return T_LPAR;
}
{RPAR} 	{
	return T_RPAR;
}
{SOMA_SINAL} 	{
	return T_MAIS;
}
{SUB_SINAL} 	{
	return T_MENOS;
}
{DIV_SINAL} 	{
	return T_DIV;
}
{MUL_SINAL} 	{
	return T_MUL;
}

%%